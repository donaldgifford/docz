<!doctype html>
<html lang="en" data-theme="{{.Theme}}" data-doc="{{.ID}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{.CSP}}">
<title>{{.FullTitle}}</title>
{{.ThemeOpen}}
<style>{{.CSS}}</style>
{{.ThemeClose}}
</head>
<body>
<div class="wrap">
<header class="page-header">
{{- if .Eyebrow}}
<p class="eyebrow">{{.Eyebrow}}</p>
{{- end}}
<h1>{{.Title}}</h1>
{{- if .Summary}}
<p class="summary">{{.Summary}}</p>
{{- end}}
<div class="meta">
{{- range .Pills}}
<span class="{{.Class}}">{{.Text}}</span>
{{- end}}
<button type="button" class="mode-toggle">Dark</button>
</div>
{{- if .Inferred}}
<p class="inferred">Sections were inferred from headings; this document carries no region markers.</p>
{{- end}}
</header>
<nav class="tabs" aria-label="Sections">
{{- range .Panels}}
<button type="button" data-tab="{{.Key}}" aria-controls="p-{{.Key}}">{{.Label}}</button>
{{- end}}
</nav>
{{- range .Panels}}
<section class="panel" id="p-{{.Key}}">
<h2 class="panel-title"{{if .Anchor}} id="{{.Anchor}}"{{end}}>{{.Label}}</h2>
{{- if .Contents}}
<ul class="heading-list">
{{- range .Contents}}
<li><a href="#{{.Slug}}">{{.Text}}</a></li>
{{- end}}
</ul>
{{- end}}
{{.Body}}
</section>
{{- end}}
<footer class="page-footer">
From <code>{{.Source}}</code>, sha256 <code>{{.SHA256}}</code>.
{{- if .Version}} Rendered by docz {{.Version}}.{{end}}
</footer>
</div>
{{.ThemeOpen}}
<script>{{.Runtime}}</script>
{{.ThemeClose}}
{{- with .Mermaid}}
{{- if .URL}}
<script src="{{.URL}}" integrity="{{.Integrity}}" crossorigin="anonymous"></script>
{{- else}}
<script>{{.Inline}}</script>
{{- end}}
<script>{{.Init}}</script>
{{- end}}
</body>
</html>
