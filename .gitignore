# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Claude Code session-local state (settings.json stays tracked)
.claude/*.local.md
.claude/settings.local.json

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
*.test
*.out
*.exe

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/



# Dependency directories (remove the comment below to include it)
# vendor/

# Go-specific (supplements registry-root .gitignore)

# Build output
/dist/
/bin/
/${project_name}

# Build directories
build/

# goreleaser output (make release-local, make release)
dist/

# Local env
.env
.env.local
.env.production

# Secrets (private keys, PEMs) — never commit, wherever they live
secrets/
deploy/secrets/
*.pem

# Go workspace file
go.work
go.work.sum

# Bun ignores
# Dependencies and build output
node_modules/
dist/
dist-msw/
dist-server/
coverage/

# Playwright output
test-results/
playwright-report/

# Generated TS client from api/openapi.yaml (bun run gen-api).
# Unanchored on purpose: a pattern with a slash in the middle is relative to
# this file's directory, so the docz-site spelling `src/api/__generated__/`
# stops matching once the app lives under ui/.
**/src/api/__generated__/

# Local environment (secrets live here, never in mise.toml)
.env.local
.env.*.local

# docz-api (merged in IMPL-0019 Phase 2)
.idea/
.vscode/
coverage.html
coverage.txt
.claude/donald-loop.local.md
