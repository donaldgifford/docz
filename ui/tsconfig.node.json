{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    // scripts/review-fake.ts runs the review page's fake server, whose
    // modules use DOM types; without this the project had them only by
    // way of Playwright's types in e2e/, which the image build excludes.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "vite.config.ts",
    "orval.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/*.ts",
    "e2e/*.ts"
  ]
}
