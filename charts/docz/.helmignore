# Patterns to ignore when building packages.
.DS_Store
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
*.swp
*.bak
*.tmp
*.orig
*~
.project
.idea/
*.tmproj
.vscode/
# Anchored to the chart root: an unanchored `tests/` also matches
# `templates/tests/`, which silently drops the `helm test` hook from the
# package (the old charts' hooks never shipped because of it).
/tests/
/ci/
README.md.gotmpl
cliff.toml
