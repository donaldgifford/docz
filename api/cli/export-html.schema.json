{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/donaldgifford/docz/schemas/cli/export-html/v1",
  "$version": "1.1",
  "title": "docz export html",
  "description": "Output of `docz export html --format json`: the whole of stdout.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Major version of this output's shape"
    },
    "out": {
      "type": "string",
      "description": "The output directory, relative to the repository root when it is under it"
    },
    "theme": {
      "type": "string",
      "description": "The pkg/theme theme the run rendered in: --theme, else the repository's html.theme (since $version 1.1)"
    },
    "dry_run": {
      "type": "boolean",
      "description": "true when nothing was written"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      },
      "description": "Each document's page in docz list order, then the index when the run wrote one"
    },
    "total": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "wrote": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["pages", "wrote", "unchanged", "failed"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "out", "theme", "dry_run", "pages", "total"],
  "additionalProperties": false,
  "$defs": {
    "page": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The document's id; empty for the index"
        },
        "type": {
          "type": "string",
          "description": "The document's canonical type; empty for the index"
        },
        "source": {
          "type": "string",
          "description": "The document's repository-relative path; empty for the index"
        },
        "path": {
          "type": "string",
          "description": "The page's path relative to the output directory"
        },
        "action": {
          "enum": ["wrote", "unchanged", "failed"],
          "description": "On a dry run, wrote means would write"
        },
        "hash": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$",
          "description": "sha256 of the page; empty when it failed"
        },
        "unresolved_links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "href": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["href", "text", "line"],
            "additionalProperties": false
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What fell back to plain rendering"
        },
        "error": {
          "type": "string",
          "description": "Why the page failed; present only then"
        }
      },
      "required": ["id", "type", "source", "path", "action", "hash", "unresolved_links", "problems"],
      "additionalProperties": false
    }
  }
}
